    "apiVersion": 3,
    "name": "jankx/sidebar-nav",
    "title": "Sidebar Navigation",
    "category": "jankx",
    "icon": "menu",
    "description": "Navigation menu for account tabs.",
    "textdomain": "jankx",
    "ancestor": ["jankx/my-account"],
    "attributes": {
        "jankxHideOnUltrawide": { "type": "boolean", "default": false },
        "jankxHideOnPc": { "type": "boolean", "default": false },
