{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "jankx/account-level-summary",
    "title": "Account Level Summary",
    "category": "jankx",
    "icon": "star-filled",
    "description": "Displays the membership level summary card.",
    "textdomain": "jankx",
    "parent": ["jankx/account-sidebar"],
    "attributes": {
        "showIcon": { "type": "boolean", "default": true },
        "showName": { "type": "boolean", "default": true },
        "showDescription": { "type": "boolean", "default": true },
        "jankxHideOnUltrawide": { "type": "boolean", "default": false },
        "jankxHideOnPc": { "type": "boolean", "default": false },
        "jankxHideOnTablet": { "type": "boolean", "default": false },
        "jankxHideOnMobile": { "type": "boolean", "default": false },
        "jankxFlexGrow": { "type": "boolean", "default": false }
    },
    "supports": {
        "html": false,
        "color": {
            "background": true,
            "text": true
        },
        "spacing": {
            "padding": true,
            "margin": true
        }
    }
}
