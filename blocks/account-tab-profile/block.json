{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "jankx/account-tab-profile",
    "title": "Profile Tab",
    "category": "jankx",
    "icon": "id",
    "description": "User profile information and password change form.",
    "textdomain": "jankx",
    "editorScript": "file:./build/index.tsx.js",
    "parent": ["jankx/account-content"],
    "attributes": {
        "jankxHideOnUltrawide": { "type": "boolean", "default": false },
        "jankxHideOnPc": { "type": "boolean", "default": false },
        "jankxHideOnTablet": { "type": "boolean", "default": false },
        "jankxHideOnMobile": { "type": "boolean", "default": false },
        "jankxFlexGrow": { "type": "boolean", "default": false }
    },
    "supports": { "html": false }
}
