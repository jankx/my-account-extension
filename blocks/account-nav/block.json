{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "jankx/account-nav",
    "title": "Account Navigation",
    "category": "jankx",
    "icon": "menu",
    "description": "Navigation menu for account tabs.",
    "textdomain": "jankx",
    "parent": [
        "jankx/my-account"
    ],
    "attributes": {
        "orientation": {
            "type": "string",
            "default": "vertical",
            "enum": [
                "vertical",
                "horizontal"
            ]
        }
    },
    "editorScript": "file:./build/index.js",
    "supports": {
        "html": false,
        "spacing": {
            "padding": true,
            "margin": true
        },
        "color": {
            "text": true,
            "background": true
        }
    }
}